# ============================================================================
# Bambu Control — Variáveis de ambiente (exemplo, SEM segredos reais)
# Copie para .env.local e preencha. NUNCA comite .env com valores reais.
# ============================================================================

# --- Supabase (público — pode chegar ao browser) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Supabase (PRIVILEGIADO — SOMENTE server-side, NUNCA no browser) ---
# service_role bypassa RLS. Só usar em Route Handlers/Server Actions/worker.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Conexão direta ao Postgres (worker/migrations)
SUPABASE_DB_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# --- Criptografia de credenciais de integração (server-side) ---
# 32 bytes em base64. Gere com: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY="generate-a-32-byte-base64-key"

# --- Integração Bambu Cloud (engenharia reversa, instável) ---
# Mantém o adaptador HTTP real DESLIGADO por padrão. true = liga (requer credenciais).
BAMBU_LIVE_ENABLED="false"
# Host regional — DESCONHECIDO/validar. Ex.: api.bambulab.com | api.bambulab.cn
BAMBU_REGION="global"

# --- Padrões do produto (configuráveis por organização depois) ---
APP_DEFAULT_TIMEZONE="America/Sao_Paulo"
APP_DEFAULT_CURRENCY="BRL"

# --- URL pública do app (usada para montar o link de convite por e-mail) ---
# Em produção: a URL do seu domínio/serviço Railway, sem barra no final.
NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"

# --- Worker de sincronização ---
# Intervalo padrão do cron de sync (minutos). Recomendado 5–15.
SYNC_INTERVAL_MINUTES="10"
